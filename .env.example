# Только для локальной разработки. В контейнере файла нет вовсе: entrypoint.mjs
# забирает те же значения из Vault и кладёт их в окружение под именами NUXT_*.
NODE_ENV=development
NITRO_HOST=0.0.0.0
NITRO_PORT=3000
SITE_URL=https://example.com
DOMAIN_NAME=example.com
DB_NAME=example-db
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=<app>
# Только на сборке: @nuxt/image печёт baseURL провайдера в бандл. Пусто —
# возьмётся значение из shared/constants/base.ts.
CLOUDINARY_CLOUD_NAME=<cloud-name>
# generate: openssl rand -hex 32
CACHE_PURGE_SECRET=<secret>
# Открывает неопубликованную страницу: /slug/?preview=<token>. Пусто —
# предпросмотра нет вовсе. В бою его заводит панель, один раз на сайт.
PREVIEW_TOKEN=<token>
